// This is your Prisma schema file
// Uses PostgreSQL (Supabase) — works on both Vercel (production) and local dev.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model OgiSubmission {
  id          String   @id @default(cuid())
  name        String
  role        String
  contact     String
  email       String?
  score       Int
  band        String
  answersJson String
  status      String   @default("new")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// DB-backed brute-force lockout for /api/admin/login — must be DB-backed
/// (not in-memory) since the app runs on Vercel serverless, where in-memory
/// state doesn't survive cold starts or scale across instances.
model AdminLoginAttempt {
  id          String    @id @default(cuid())
  ip          String    @unique
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}
